<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5E0">

    <!-- Sapaan dan profil -->
    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        android:text="Hello, Rin"
        android:textColor="#190933"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Have a great day"
        android:textSize="14sp"
        android:textColor="#190933"
        app:layout_constraintTop_toBottomOf="@id/tvGreeting"
        app:layout_constraintStart_toStartOf="@id/tvGreeting" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_profile_placeholder"
        android:layout_marginEnd="16dp"
        android:scaleType="centerCrop"
        android:contentDescription="Profile image"
        app:layout_constraintTop_toTopOf="@id/tvGreeting"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImageView"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="1dp" />

    <!-- Kartu Tanggal dan Waktu -->
    <LinearLayout
        android:id="@+id/llDateTimeCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubGreeting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tanggal -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monday"
                android:textColor="#190933"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="27"
                android:textSize="32sp"
                android:textColor="#190933"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="March"
                android:textColor="#190933"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:background="#000000" />

        <!-- Waktu -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Indonesia"
                android:textColor="#190933"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="08.00"
                android:textSize="32sp"
                android:textColor="#190933"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Mood -->
    <LinearLayout
        android:id="@+id/llMoodCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/llDateTimeCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/how_are_you_feeling_today"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#190933"
            android:layout_gravity="center_vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/add_mood"
            android:textColor="#FFFFFF"
            app:backgroundTint="#190933"
            app:cornerRadius="20dp"
            android:minWidth="170dp"
            android:minHeight="48dp" />
    </LinearLayout>

    <!-- Label Journey -->
    <TextView
        android:id="@+id/tvJourney"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/journey"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#190933"
        app:layout_constraintStart_toStartOf="@id/llMoodCard"
        app:layout_constraintTop_toBottomOf="@id/llMoodCard" />

    <!-- Journey Card -->
    <!-- Card Journey section (diperbaiki agar responsive) -->
    <!-- Journey Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clJourneyCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/bg_card"
        android:clipToPadding="false"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvJourney"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Label Recently Added -->
        <TextView
            android:id="@+id/tvRecentlyAdded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recently_added"
            android:textColor="#190933"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentlyAdded"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            app:layout_constraintTop_toBottomOf="@id/tvRecentlyAdded"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/btnAddNote"
            tools:listitem="@layout/item_note_card" />

        <!-- Tombol Add Note -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddNote"
            android:layout_width="170dp"
            android:layout_height="48dp"
            android:text="Add Note"
            android:textColor="#FFFFFF"
            app:backgroundTint="#190933"
            app:cornerRadius="20dp"
            app:layout_constraintTop_toBottomOf="@id/rvRecentlyAdded"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>



    <!-- Bottom Nav -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
